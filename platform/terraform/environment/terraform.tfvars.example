# Examples only. No AMI, instance size, or account is approved for apply.
account_id        = "123456789012"
project_name      = "ticket-platform"
region            = "us-east-1"
availability_zone = "us-east-1c"
instance_type     = "t3.medium"
ami_id            = "ami-00000000000000000"
root_volume_gib   = 30
backup_bucket_name = "replace-with-globally-unique-project-backup-name"
notification_email = "replace@example.invalid"
teardown_after_utc = "2099-01-01T00:00:00Z"

# Inspect the account first. Reuse an existing shared provider; never overwrite it.
create_github_oidc_provider        = false
existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
github_repository                 = "your-owner/your-repository"
github_repository_owner_id        = "12345678"
github_repository_id              = "123456789"
