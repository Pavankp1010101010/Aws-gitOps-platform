{
  "name": "support-ticket-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "setup:local": "node scripts/setup-local.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "check": "node --check src/app.js && node --check src/server.js && node --check public/app.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "@prometheus-io/client": "0.16.1"
  }
}
